<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    BridgingAnalyzer —— 搭路数据分析插件,本服的核心玩法。

    上游: https://github.com/SakuraKoi/BridgingAnalyzer (GPL v2, 作者 SakuraKooi)
    本项目是它的 1.21.11 移植版,包名保留 sakura.kooi 以尊重出处。
    版本号 28-1.21.11 表示"上游 v28 的 1.21.11 移植"。

    许可:GPL v2。自用无义务;若分发改后的 jar,须同样以 GPL v2 开源。
  -->
  <groupId>sakura.kooi</groupId>
  <artifactId>BridgingAnalyzer</artifactId>
  <version>28-1.21.11</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <!-- paper-api 只在 PaperMC 自建仓库,不在 Central -->
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!--
      provided 作用域:服务端运行时自带,不打进 jar。
      1.8 原版依赖的是 spigot-1.8.8-R0.1-SNAPSHOT,这里换成 Paper 1.21.11 ——
      移植的全部工作量就来自这一行的变化。
    -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.21.11-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- plugin.yml 里的 ${project.version} 需要过滤替换 -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>

</project>
